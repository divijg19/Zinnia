{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"paths": {
			"@lib/*": ["./lib/*"]
		},
		"typeRoots": ["./types", "./node_modules/@types"],
		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		// Some stricter flags (disabled by default)
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": [
		"lib/**/*.ts",
		"api/**/*.ts",
		"stats/src/**/*.ts",
		"trophy/src/renderer.ts",
		"trophy/api/**/*.ts",
		"streak/src/**/*.ts",
		"streak/api/**/*.ts",
		// Widget-local test dirs, which sit outside the top-level `tests/` tree
		// and were therefore still unchecked. None of them import build
		// artifacts, so this stays safe in the lint job that runs before a build.
		"streak/tests/**/*.ts",
		"leetcode/api/**/*.ts",
		"leetcode/test/**/*.ts",
		"leetcode/packages/*/src/_test/**/*.ts",
		// Tests were outside the program entirely, so `tsc --noEmit` (and thus
		// `bun run lint`) never type-checked them. Included as `tests/**/*`
		// rather than `tests/**/*.ts` so the .js test files are covered too
		// (allowJs is already on).
		"tests/**/*",
		"types/**/*.d.ts"
	],
	"exclude": [
		// Quarantine Deno-specific files and folders (not part of Node/Vercel build)
		"trophy/main.ts",
		"trophy/deps.ts",
		"trophy/src/StaticRenderRegeneration/**",
		"trophy/src/Types/deno.d.ts"
	]
}
