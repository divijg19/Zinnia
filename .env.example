# Example environment file for local development
# Copy to .env or .env.local and fill in with your tokens

# GitHub personal access tokens (classic or fine-grained with public-repo
# read). The router round-robins PAT_1..PAT_5 and skips exhausted keys.
# A single GITHUB_TOKEN also works as a fallback seed for PAT_1.
PAT_1=
PAT_2=
PAT_3=
PAT_4=
PAT_5=
# GITHUB_TOKEN=

# Optional namespace so multiple deployments sharing one KV don't collide.
# PAT_STORE_NAMESPACE=zinnia

# Optional Upstash KV for PAT coordination and streak caching.
# Any one URL + token pair works; UPSTASH_PREFIX rewrites the lookup names
# (e.g. ZINNIA) for Vercel Marketplace installs with a custom prefix.
# UPSTASH_REST_URL=
# UPSTASH_REST_TOKEN=
# UPSTASH_PREFIX=UPSTASH
# UPSTASH_DEBUG=1

# Cache TTLs (seconds). CACHE_SECONDS is the global fallback; each service
# override wins over it, and ?cache= wins over both (within its clamp range).
# CACHE_SECONDS=86400
# STATS_CACHE_SECONDS=
# TOP_LANGS_CACHE_SECONDS=
# STREAK_CACHE_SECONDS=
# TROPHY_CACHE_SECONDS=
# LEETCODE_CACHE_SECONDS=
# GITHUB_CACHE_SECONDS=
# HEALTH_CACHE_SECONDS=

# Outbound fetch timeouts (milliseconds, default 8000). KV calls are fixed
# at 5000ms. Timeouts fail fast into the error SVG — never retried.
# STATS_GRAPHQL_TIMEOUT_MS=
# STATS_REST_TIMEOUT_MS=
# STREAK_FETCH_TIMEOUT_MS=
# TROPHY_GRAPHQL_TIMEOUT_MS=
# LEETCODE_GRAPHQL_TIMEOUT_MS=

# File cache directories (best-effort, disabled unless set).
# CACHE_DIR=
# TROPHY_CACHE_DIR=
# STREAK_CACHE_DIR=
