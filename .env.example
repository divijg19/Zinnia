# Example environment file for local development
# Copy to .env or .env.local and fill in with your tokens

# GitHub personal access tokens (classic or fine-grained with public-repo
# read). The router round-robins PAT_1..PAT_5 and skips exhausted keys.
# A single GITHUB_TOKEN also works as a fallback seed for PAT_1.
PAT_1=
PAT_2=
PAT_3=
PAT_4=
PAT_5=
# GITHUB_TOKEN=

# Optional namespace so multiple deployments sharing one KV don't collide.
# PAT_STORE_NAMESPACE=zinnia

# Optional Upstash KV for PAT coordination, streak caching, and the render
# cache that keeps README embeds answering instantly.
# Any one URL + token pair works; UPSTASH_PREFIX rewrites the lookup names
# (e.g. ZINNIA) for Vercel Marketplace installs with a custom prefix.
# UPSTASH_REST_URL=
# UPSTASH_REST_TOKEN=
# UPSTASH_PREFIX=UPSTASH
# UPSTASH_DEBUG=1

# Alternative KV backend: a managed Redis URL, used instead of Upstash REST
# when the ioredis client is installed.
# REDIS_URL=

# Cache TTLs (seconds). CACHE_SECONDS is the global fallback; each service
# override wins over it, and ?cache= wins over both (within its clamp range).
# CACHE_SECONDS=86400
# STATS_CACHE_SECONDS=
# TOP_LANGS_CACHE_SECONDS=
# STREAK_CACHE_SECONDS=
# TROPHY_CACHE_SECONDS=
# LEETCODE_CACHE_SECONDS=
# HEALTH_CACHE_SECONDS=

# Render cache (lib/render-cache.ts). Stores rendered SVGs in process memory and,
# when the KV env vars above are set, in KV. Keeps a TTL expiry off the GitHub
# API and lets a failed or slow refresh still return the previous card. Set
# RENDER_CACHE=0 to turn it off.
# RENDER_CACHE=1
# Two wall-clock budgets for one render, in ms.
#
# RENDER_DEADLINE_MS (3500) applies when a previous render is cached: hitting it
# means a stale card can be served immediately, so there is nothing to gain by
# waiting.
# RENDER_CEILING_MS (8500) applies when nothing is cached, where the only
# alternatives are the real card and an error card. Keep it above your longest
# outbound fetch timeout (8000 by default) so it only fires after the upstream
# has already given up, and below GitHub Camo's 10s origin fetch timeout - above
# that, a slow render becomes a blank embed instead of a late one.
# RENDER_DEADLINE_MS=3500
# RENDER_CEILING_MS=8500

# Outbound fetch timeouts (milliseconds, default 8000). KV calls are fixed
# at 5000ms, or 400ms on the render-cache path. Timeouts fail fast into the
# error SVG; there is no retry.
# STATS_GRAPHQL_TIMEOUT_MS=
# STATS_REST_TIMEOUT_MS=
# STREAK_FETCH_TIMEOUT_MS=
# TROPHY_GRAPHQL_TIMEOUT_MS=
# LEETCODE_GRAPHQL_TIMEOUT_MS=

# File cache directories (best-effort, disabled unless set).
# CACHE_DIR=
# TROPHY_CACHE_DIR=
# STREAK_CACHE_DIR=

# Debug switches. All are off unless set to 1, and all only add logging or
# extra response headers; none changes the card output itself.
# TOKENS_DEBUG=1                       # PAT selection and seeding decisions
# ZINNIA_EXPOSE_ERROR_HEADERS=1        # echo the error code/message to
                                      # X-Error-Code / X-Error-Message
