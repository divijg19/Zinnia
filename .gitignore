# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Build outputs (per-package dists, bundles)
dist

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
.vercel/

# Vendor backups and large archives
_vendor_backup/

scripts/*
!scripts/build-shards.sh
!scripts/generate-demo-assets.js
!scripts/smoke-embeds.js
cache/

# --- Consolidated package ignores ---
# Package-local IDE files, demos and archives
.idea/
.vscode/
.DS_Store

# LeetCode / Worker build artifacts
.wrangler/
worker.capnp
.storage/

# Editor / workspace
*.code-workspace

# Demo folders that should not be tracked or deployed
**/src/**/demo/**

# API build outputs used at deploy-time; generated, don't commit
api/_build/**
stats/api/*.js
stats/api/*.js.map

# Vercel helper files
!.vercelignore

# Additional consolidated entries from packages
# Trophy and stats package-specific ignores
*.sh
!scripts/build-shards.sh
!scripts/e2e_smoke.sh
benchmarks
!streak/src/demo/preview.ts

# local & tooling
tmp/
.husky/

# Vendored trophy snapshot (archival) - keep out of active tree unless intentionally edited
trophy/_vendor/

# Demo generated assets (generated at build time)
demo/assets/
demo/theme-registry.json
demo/mock-data.json
public/demo/
