{
	"name": "zinnia",
	"type": "module",
	"private": true,
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"pretest": "bun run build",
		"build": "bash scripts/build-shards.sh",
		"demo:build": "bun scripts/generate-demo-assets.ts && bun scripts/build-demo.ts",
		"demo:dev": "bun run demo:build && bunx serve public/demo",
		"vercel:deploy": "vercel --prod --token $VERCEL_TOKEN --yes",
		"lint": "biome check --error-on-warnings && tsc --noEmit",
		"format": "biome format . --write",
		"type-check": "tsc --noEmit --incremental",
		"test:stats": "vitest --run tests/stats",
		"test:api": "vitest --run tests/api",
		"test:demo": "bun run demo:build && bun tests/demo-assets.smoke.ts",
		"test:leetcode": "vitest --run leetcode/test",
		"test": "vitest --run",
		"embed:smoke": "bun scripts/smoke-embeds.ts",
		"embed:check": "bun scripts/check-profile-embeds.ts",
		"warm": "bun scripts/warm-embeds.ts",
		"e2e:local": "bun run build && bun run demo:build && (bunx vercel dev --listen 3000 & sleep 3) && bash scripts/e2e_smoke.sh http://localhost:3000"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"@vercel/node": "^32.0.0",
		"@vitest/coverage-v8": "^5.1.1",
		"jsdom": "^31.0.1",
		"typescript": "^7.0.2",
		"vercel": "^66.6.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"emoji-name-map": "^2.0.3",
		"sharp": "^0.35.5"
	},
	"overrides": {
		"tar": "^7.5.7"
	}
}
