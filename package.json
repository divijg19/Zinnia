{
	"name": "zinnia",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"pretest": "bun run build",
		"build": "bash scripts/build-shards.sh",
		"demo:build": "bun scripts/generate-demo-assets.js && mkdir -p public/demo && cp -r demo/* public/demo/",
		"demo:dev": "bun scripts/generate-demo-assets.js && bunx serve demo",
		"vercel:deploy": "vercel --prod --token $VERCEL_TOKEN --yes",
		"lint": "biome check --error-on-warnings . && tsc --noEmit",
		"format": "biome format . --write",
		"type-check": "tsc --noEmit",
		"test:stats": "vitest --run --config ./vitest.config.ts tests/stats",
		"test:api": "vitest --run --config ./vitest.config.ts tests/api",
		"test:demo": "bun run demo:build && bun tests/demo-assets.smoke.js",
		"test:leetcode": "vitest --run --config ./vitest.config.ts leetcode/test",
		"test": "vitest --run",
		"embed:smoke": "bun scripts/smoke-embeds.js",
		"e2e:local": "bun run build && bun run demo:build && (bunx vercel dev --listen 3000 & sleep 3) && bash scripts/e2e_smoke.sh http://localhost:3000"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@vitest/coverage-v8": "^5.0.2",
		"jsdom": "^30.1.1",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vercel": "^60.1.3",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@vercel/node": "^16.0.1",
		"dotenv": "^18.0.4",
		"emoji-name-map": "^2.0.3",
		"sharp": "^0.35.4"
	},
	"overrides": {
		"basic-ftp": "^5.2.0",
		"tar": "^7.5.7",
		"rollup": "^4.59.0"
	}
}
