{
	"version": 2,
	"functions": {
		"api/**/*.ts": {
			"includeFiles": "{api/_build/**,stats/api/**,streak/dist/**,leetcode/packages/core/dist/**}"
		}
	},
	"rewrites": [
		{
			"source": "/demo",
			"destination": "/demo/index.html"
		},
		{
			"source": "/demo/(.*)",
			"destination": "/demo/$1"
		},
		{
			"source": "/(.*)",
			"destination": "/api/$1"
		}
	],
	"headers": [
		{
			"source": "/demo/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
